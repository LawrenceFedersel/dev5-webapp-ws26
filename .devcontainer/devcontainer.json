{
    "name": "C# (.NET)",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0.301",
    "runArgs": [ // docker run <runArgs> wie docker run --network deo-network
        "--name",
        "deo-devcontainer",
        "--network",
        "deo-network"
    ],
    "remoteEnv": {
        "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
    },
    "postCreateCommand": "dotnet restore --force-evaluate && dotnet dev-certs https && dotnet dev-certs https --trust || true",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "SonarSource.sonarlint-vscode",
                "humao.rest-client"
            ]
        }
    }
}